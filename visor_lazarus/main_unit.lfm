object FormVisor: TFormVisor
  Left = 240
  Height = 310
  Top = 160
  Width = 1060
  BorderIcons = [biSystemMenu, biMinimize]
  BorderStyle = bsSingle
  Caption = 'By Alberto Caro'
  ClientHeight = 310
  ClientWidth = 1060
  Color = clBtnFace
  Font.Color = clWindowText
  Font.Height = -11
  Font.Name = 'Tahoma'
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  Position = poScreenCenter
  ShowHint = True
  LCLVersion = '4.8.0.0'
  object lblMainTitle: TLabel
    Left = 250
    Height = 24
    Top = 14
    Width = 460
    Alignment = taCenter
    AutoSize = False
    Caption = 'Material Particulado 2.5 um'
    Font.Color = clBlack
    Font.Height = -19
    Font.Name = 'Arial'
    Font.Style = [fsBold]
    ParentFont = False
  end
  object btnSave: TSpeedButton
    Left = 780
    Height = 32
    Hint = 'Guardar captura de pantalla en captura.png'
    Top = 10
    Width = 85
    Caption = 'Save'
    Font.Color = clBlack
    Font.Height = -12
    Font.Name = 'Tahoma'
    Font.Style = [fsBold]
    ParentFont = False
    ShowHint = True
    OnClick = btnSaveClick
  end
  object btnGridToggle: TSpeedButton
    Left = 875
    Height = 32
    Hint = 'Activar / Desactivar la grilla del visor'
    Top = 10
    Width = 85
    Caption = 'On/off'
    Font.Color = clBlack
    Font.Height = -12
    Font.Name = 'Tahoma'
    Font.Style = [fsBold]
    ParentFont = False
    ShowHint = True
    OnClick = btnGridToggleClick
  end
  object btnChangeBg: TSpeedButton
    Left = 968
    Height = 44
