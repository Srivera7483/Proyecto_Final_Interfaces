    Top = 200
    Width = 78
    Caption = 'Click'
    Font.Color = clBlack
    Font.Height = -12
    Font.Name = 'Tahoma'
    Font.Style = [fsBold]
    ParentFont = False
    ShowHint = True
    OnClick = btnChangeBgClick
  end
  object ChartVisor: TChart
    Left = 15
    Height = 245
    Top = 50
    Width = 945
    AxisList = <    
      item
        Grid.Color = clBlack
        Grid.Style = psDot
        Grid.Visible = False
        Marks.LabelBrush.Style = bsClear
        Minors = <>
        Range.Max = 200
        Range.Min = 0
        Range.UseMax = True
        Range.UseMin = True
        Title.LabelFont.Color = clBlack
        Title.LabelFont.Height = -14
        Title.LabelFont.Name = 'Arial'
        Title.LabelFont.Style = [fsBold]
        Title.Visible = True
        Title.Caption = '[ug/m3]'
      end    
      item
        Alignment = calBottom
        Grid.Color = clBlack
        Grid.Style = psDot
        Grid.Visible = False
        Marks.LabelBrush.Style = bsClear
        Minors = <>
        Range.Max = 29
        Range.Min = 0
        Range.UseMax = True
        Range.UseMin = True
        Title.LabelFont.Color = clBlack
        Title.LabelFont.Height = -14
        Title.LabelFont.Name = 'Arial'
        Title.LabelFont.Style = [fsBold]
        Title.Visible = True
        Title.Caption = 'Sampling MP 2.5um'
      end>
    BackColor = clWhite
    Foot.Brush.Color = clBtnFace
    Foot.Font.Color = clBlue
    Legend.Alignment = laTopRight
    Legend.BackgroundBrush.Color = clWhite
    Legend.Frame.Color = clBlack
    Legend.Frame.Visible = True
    Legend.UseSidebar = False
    Legend.Visible = True
    OnBeforeDrawBackWall = ChartVisorBeforeDrawBackWall
    Title.Brush.Color = clBtnFace
    Title.Font.Color = clBlue
    Title.Text.Strings = (
      'TAChart'
    )
    Title.Visible = False
    object SerieMP25: TLineSeries
      AxisIndexX = 1
      AxisIndexY = 0
      LinePen.Color = clRed
      LinePen.Width = 1
      Marks.Arrow.Visible = False
      Marks.Distance = 4
      Marks.Format = '%0:.0f'
      Marks.Frame.Color = clBlack
      Marks.Frame.Visible = True
      Marks.LabelBrush.Color = clWhite
      Marks.LabelBrush.Style = bsSolid
      Marks.Style = smsValue
      Marks.Visible = True
      Pointer.Brush.Color = clHighlight
      Pointer.HorizSize = 4
      Pointer.Pen.Color = clYellow
      Pointer.Pen.Width = 1
      Pointer.Style = psRectangle
      Pointer.VertSize = 4
      Pointer.Visible = True
      SeriesColor = clRed
      ShowPoints = True
      Title = 'MP 2.5 um'
    end
  end
  object LazSerial1: TLazSerial
    Active = False
    BaudRate = br__9600
    DataBits = db8bits
    Parity = pNone
    FlowControl = fcNone
    StopBits = sbOne
    Device = 'COM2'
    RcvLineCRLF = False
